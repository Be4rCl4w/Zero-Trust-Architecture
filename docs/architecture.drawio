ize=11;fontColor=#222;" vertex="1" parent="1"><mxGeometry x="202" y="921" width="460" height="18" as="geometry"/></mxCell><mxCell id="n98" value="3  Web tier calls the app tier on 8080" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#222;" vertex="1" parent="1"><mxGeometry x="202" y="943" width="460" height="18" as="geometry"/></mxCell><mxCell id="n99" value="4  App tier reaches SQL (1433) and Key Vault (443) over private endpoints" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#222;" vertex="1" parent="1"><mxGeometry x="202" y="965" width="460" height="18" as="geometry"/></mxCell><mxCell id="n100" value="5  Admin reaches VMs only through Bastion with Entra login" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#222;" vertex="1" parent="1"><mxGeometry x="672" y="899" width="460" height="18" as="geometry"/></mxCell><mxCell id="n101" value="6  CI/CD runner deploys from inside the network" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#222;" vertex="1" parent="1"><mxGeometry x="672" y="921" width="460" height="18" as="geometry"/></mxCell><mxCell id="n102" value="7  All egress is forced through Azure Firewall" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#222;" vertex="1" parent="1"><mxGeometry x="672" y="943" width="460" height="18" as="geometry"/></mxCell><mxCell id="n103" value="Layer 1  bootstrap.tf   applied locally from a PAW" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1160" y="898.5" width="520" height="19.5" as="geometry"/></mxCell><mxCell id="n104" value="Layer 2  main.tf        applied by GitHub Actions" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1160" y="920.5" width="520" height="19.5" as="geometry"/></mxCell><mxCell id="n105" value="Layer 3  catalogue.tf